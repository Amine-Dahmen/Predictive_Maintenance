{
  "name": "maintenance-predictive-iot-backend",
  "version": "1.0.0",
  "description": "API REST + passerelle MQTT de l'application IoT de maintenance prédictive",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "simulateur": "node scripts/simulateur-esp32.js",
    "mqtt:users": "powershell -ExecutionPolicy Bypass -File scripts/creer-utilisateurs-mqtt.ps1",
    "mqtt:users:linux": "bash scripts/creer-utilisateurs-mqtt.sh",
    "mqtt": "\"C:\\Program Files\\Mosquitto\\mosquitto.exe\" -c mosquitto/config/mosquitto.conf -v",
    "mqtt:linux": "bash scripts/mosquitto.sh",
    "test": "node --test tests/*.test.js",
    "db:archive": "node src/db/archive.js",
    "db:backup": "bash scripts/sauvegarde-db.sh",
    "db:restore": "bash scripts/restaurer-db.sh",
    "rapport": "node scripts/rapport.js",
    "firmware:publier": "node scripts/publier-firmware.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^1.0.2"
  }
}
