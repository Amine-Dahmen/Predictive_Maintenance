# Copiez ce fichier en .env et remplacez les valeurs. Ne poussez JAMAIS le fichier .env sur GitHub.

NODE_ENV=development
PORT=3000

# Origines autorisées à appeler l'API (front web, mobile en dev), séparées par des virgules
CORS_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:3001

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance_iot
DB_USER=maint
DB_PASSWORD=maint_password

# ---------- JWT ----------
# Générez deux secrets différents et longs : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=remplacez_par_un_secret_long_et_aleatoire_1
JWT_REFRESH_SECRET=remplacez_par_un_secret_long_et_aleatoire_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ---------- MQTT ----------
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=backend_mqtt_pwd
MQTT_CLIENT_ID=backend-maintenance
MQTT_TOPIC_PREFIX=usine

# Délai (secondes) sans mesure avant qu'un capteur soit déclaré inactif
CAPTEUR_DELAI_INACTIVITE_S=60

# ---------- Compte directeur créé par "npm run db:seed" ----------
SEED_DIRECTEUR_EMAIL=directeur@usine.local
SEED_DIRECTEUR_PASSWORD=ChangezMoi123!

# ---------- Release 3 ----------
# US-38 : envoi des alertes par e-mail. Laisser SMTP_HOST vide : les e-mails sont seulement écrits dans le journal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PrédiMaint <noreply@usine.local>

# US-25 : dossier des photos jointes aux interventions
UPLOADS_DIR=uploads
# US-40 : durée de conservation des mesures brutes (jours) avant résumé horaire. 0 = conservation illimitée
MESURES_RETENTION_JOURS=90
# US-46 : versions de firmware publiées (npm run firmware:publier) et adresse de l'API vue par les cartes
FIRMWARE_DIR=firmware
# PUBLIC_BASE_URL=http://192.168.1.10:3000

# ---------- US-22 : prédiction de panne (service ml/, voir ml/README.md) ----------
ML_URL=http://localhost:8000
# ML_API_KEY=mettez_la_meme_valeur_que_dans_le_service_ml
# Calcul toutes les 5 min ; 0 = désactivé
PREDICTION_INTERVALLE_S=300
# Pas d'agrégation des mesures : 3600 (1 h, comme à l'entraînement). Démonstration : 60 (192 min d'historique)
PREDICTION_PAS_S=3600
