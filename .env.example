# Variables du docker-compose racine. Copiez en .env (ignoré par git) et remplacez chaque valeur.
# Secrets : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_PASSWORD=change-moi-db
JWT_ACCESS_SECRET=change-moi-un-secret-long-de-plus-de-32-caracteres-1
JWT_REFRESH_SECRET=change-moi-un-secret-long-de-plus-de-32-caracteres-2
SEED_DIRECTEUR_PASSWORD=ChangeMoiAuDemarrage1!
MQTT_BACKEND_PASSWORD=change-moi-mqtt-backend
# Un compte par carte ESP32 : CODE:motdepasse séparés par des espaces (même mot de passe que credentials.py)
MQTT_MACHINES=M01:change-moi-esp32-M01
ML_API_KEY=change-moi-cle-ia
# Origines web autorisées (navigateur) ; ajoutez http://<IP_DU_PC>:8080 pour un autre PC du réseau
CORS_ORIGINS=http://localhost:8080
# Adresse de l'API vue par les cartes pour la mise à jour du firmware (US-46), ex. http://192.168.1.10:3000
PUBLIC_BASE_URL=
# 3600 en production, 60 pour une démonstration accélérée de la prédiction
PREDICTION_PAS_S=3600
